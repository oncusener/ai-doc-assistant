# --- Language model --------------------------------------------------------
# "claude" (default) uses the Anthropic API. "openai-compatible" points at any
# OpenAI-compatible endpoint (a local gateway, Ollama, ...) and is meant for
# zero-cost local development only.
LLM_PROVIDER=claude

# Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (Claude Opus 5.5 defaults to medium)
CLAUDE_EFFORT=medium

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai-compatible), e.g. Ollama
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama3.1

# --- Storage ---------------------------------------------------------------
# Leave empty to use the embedded database (PGlite + pgvector) in ./data/pg.
# Set to a PostgreSQL URL with the pgvector extension to use a real server,
# e.g. postgres://postgres:postgres@localhost:5432/docassistant
DATABASE_URL=

# --- Retrieval -------------------------------------------------------------
# Multilingual embedding model, runs locally (downloaded once, ~120 MB).
EMBEDDING_MODEL=Xenova/multilingual-e5-small
RETRIEVAL_TOP_K=6

# --- Server ----------------------------------------------------------------
PORT=8787
# Company name shown in the web app (optional)
BRAND_NAME=
# Max upload size in megabytes
MAX_UPLOAD_MB=20
